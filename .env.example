# AETHER — Environment Configuration Template
# Copy this file to `.env` if overriding local gateway settings.
# Note: All primary meteorological providers (Open-Meteo, Nominatim, RainViewer)
# are open-access and require no secret API keys.

PORT=3000
AETHER_CACHE_TTL_SECONDS=300
AETHER_RATE_LIMIT_CAPACITY=120
AETHER_RATE_LIMIT_REFILL_PER_SEC=25
